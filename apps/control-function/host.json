{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "queues": {
      "batchSize": 1,
      "maxDequeueCount": 5,
      "maxPollingInterval": "00:00:05",
      "messageEncoding": "none",
      "newBatchThreshold": 0,
      "visibilityTimeout": "00:00:30"
    }
  },
  "functionTimeout": "00:05:00",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": false
      }
    }
  }
}
