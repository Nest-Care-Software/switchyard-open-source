{
  "name": "@switchyard/azure-ledger-bootstrap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build --workspace @switchyard/azure-ledger && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "npm run build --workspace @switchyard/azure-ledger && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "typecheck": "npm run build --workspace @switchyard/azure-ledger && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/core-auth": "1.11.0",
    "@azure/data-tables": "13.3.2",
    "@switchyard/azure-ledger": "0.0.0",
    "@switchyard/core": "0.0.0"
  }
}
