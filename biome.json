{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.test-dist",
      "!!**/.terraform",
      "!!infra/foundation/activation.json",
      "!!infra/foundation/bootstrap-authority.json",
      "!!infra/foundation/main.json",
      "!!infra/foundation/oidc-subject-correction.json",
      "!!infra/templates/azure-allocation/main.json",
      "!!infra/templates/azure-allocation/jit-launch.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
