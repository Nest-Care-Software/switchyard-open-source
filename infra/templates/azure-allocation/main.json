      "metadata": {
        "description": "Reviewed, non-secret bootstrap payload supplied by the controller. It must never contain tokens, JIT configuration, private keys or credentials. The secure decorator is defence in depth for deployment history, not permission to pass secrets through VM custom data."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Additional non-secret allocation tags. Mandatory lifecycle tags below take precedence."
      }
    }
  },
  "variables": {
    "latestSafeStart": "[dateTimeAdd(parameters('originalCompleteBy'), format('-PT{0}M', add(parameters('mappedJobTimeoutMinutes'), parameters('providerStopMarginMinutes'))))]",
    "expectedOriginalCompleteBy": "[dateTimeAdd(parameters('allocationAcceptedAt'), format('PT{0}M', sub(parameters('allocationLifetimeMinutes'), 5)))]",
    "expectedDeletionTarget": "[dateTimeAdd(parameters('allocationAcceptedAt'), format('PT{0}M', parameters('allocationLifetimeMinutes')))]",
    "latestSafeStartOffsetMinutes": "[sub(sub(sub(parameters('allocationLifetimeMinutes'), 5), parameters('mappedJobTimeoutMinutes')), parameters('providerStopMarginMinutes'))]",
    "deadlineContractValid": "[and(and(equals(parameters('originalCompleteBy'), variables('expectedOriginalCompleteBy')), equals(parameters('deletionTarget'), variables('expectedDeletionTarget'))), greaterOrEquals(variables('latestSafeStartOffsetMinutes'), 0))]",
    "allocationTags": "[union(parameters('tags'), createObject('allocationAcceptedAt', parameters('allocationAcceptedAt'), 'allocationId', parameters('allocationId'), 'allocationLifetimeMinutes', string(parameters('allocationLifetimeMinutes')), 'deletionTarget', parameters('deletionTarget'), 'githubRunId', parameters('githubRunId'), 'latestSafeStart', variables('latestSafeStart'), 'managedBy', 'switchyard-controller', 'mappedJobTimeoutMinutes', string(parameters('mappedJobTimeoutMinutes')), 'originalCompleteBy', parameters('originalCompleteBy'), 'providerStopMarginMinutes', string(parameters('providerStopMarginMinutes')), 'system', 'switchyard'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
