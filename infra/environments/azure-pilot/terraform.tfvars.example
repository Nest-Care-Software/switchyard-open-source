# Non-secret identifiers only. Copy outside the repository and replace every
# example value before any future plan. This phase authorises validation only,
# not cloud authentication, plan or apply.
dedicated_subscription_confirmed = true
subscription_id                  = "00000000-0000-0000-0000-000000000000"
tenant_id                        = "00000000-0000-0000-0000-000000000000"
deployment_principal_object_id   = "00000000-0000-0000-0000-000000000000"
owner_principal_object_id        = "00000000-0000-0000-0000-000000000000"
owner_recovery_principal_object_id = "00000000-0000-0000-0000-000000000000"
function_auth_client_id          = "00000000-0000-0000-0000-000000000000"
github_workload_client_id        = "00000000-0000-0000-0000-000000000000"
alert_email                      = "owner@example.invalid"
ledger_instance_id               = "11111111-1111-4111-8111-111111111111"
ledger_partition_key             = "control-v10"
ledger_schema_version            = 10

# These must be globally unique and satisfy the module validations.
storage_account_name = "switchyardreplace"
key_vault_name        = "kv-switchyard-replace"
function_app_name     = "func-switchyard-replace"

# No placeholder is safe here. Resolve an exact UK South Marketplace version
# before a future plan, then add runner_image_version as a three-part version.

# Keep false unless the live Doppler managed-identity test fails and the owner
# explicitly approves the one-token Key Vault exception.
doppler_bootstrap_enabled = false

# Function deployment is deliberately disabled. A later reviewed two-dispatch
# activation must bind the deterministic ZIP built by npm run function:bundle
# and its lowercase digest from the adjacent .sha256 file to the exact plan.
function_package_deployment_enabled = false
# function_package_path             = "../../../.artifacts/control-function/switchyard-control-function.zip"
# function_package_sha256           = "replace-with-the-reviewed-lowercase-sha256"

# Admission stays unavailable until every reviewed non-secret setting is
# supplied together. Secrets remain in Doppler and must never enter this map.
admission_runtime_settings = {}

tags = {
  owner = "example-owner"
}
